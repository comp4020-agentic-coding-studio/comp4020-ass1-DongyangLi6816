---
import Placenames from "../components/placenames.astro";
import Seamarks from "../components/seamarks.astro";
import rawCoastline from "../components/coastline.svg?raw";
import { roughen } from "../data/coastline.ts";
import track from "../audio/temple-of-the-manes.m4a";
import {
  NOSTOS_DAYS,
  STOPS,
  dayAt,
  nostosRoutePoints,
  projectMarker,
  routePoints,
} from "../data/voyage.ts";
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
const markers = STOPS.map((stop, i) => ({
  ...stop,
  index: i,
  marker: projectMarker(stop),
  day: dayAt(i),
}));

// A curve through the stops and the sea marks between them, not a polyline:
// a voyage drawn as straight hops reads as a network diagram, and several of
// those hops went over land. The curve passes exactly through each stop, so
// the line, the buttons and the ship still agree to the pixel.
// Drawn in the coastline's own coordinate space rather than in percentages.
//
// The route used to be a 0-100 box stretched with `preserveAspectRatio="none"`,
// which forced `vector-effect: non-scaling-stroke` on it to stop the stroke
// going oval --- and the two engines disagree about whether a non-scaling
// stroke's *dash* lengths follow an ancestor's CSS transform. Compensating for
// one broke the other: dashes read as solid on Chrome uncompensated and on
// WebKit compensated. In a box with the map's real aspect ratio the stroke is
// round without any vector-effect, and dash lengths are ordinary user units
// that both engines treat the same way.
const MAP_W = 1600;
const MAP_H = 953.8;
const inMapUnits = (points: { x: number; y: number }[]) =>
  points
    .map(
      (p) =>
        `${((p.x / 100) * MAP_W).toFixed(1)},${((p.y / 100) * MAP_H).toFixed(1)}`,
    )
    .join(" ");
const route = inMapUnits(routePoints().points);
// The voyage that should have happened, drawn in the same space by the same
// sampler. It shares this line with the real course as far as Cape Malea.
const nostosRoute = inMapUnits(nostosRoutePoints());
// Roughened here, at build time. It used to be an SVG filter in the browser,
// which WebKit dropped on every large landmass --- see src/data/coastline.ts.
const coastline = roughen(rawCoastline);
---

<!doctype html>
{/* The stage lives on the root element rather than on `main` so the script
    below can set it before the first paint. Everything the prologue hides is
    hidden by CSS keyed off this attribute --- no element is added or removed,
    so nothing reflows when the voyage arrives. */}
<html lang="en" data-stage="prologue">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Inline and blocking, before anything is drawn.
        The prologue is a five-second animation and one visitor must not be
        shown it: whoever has asked the system for less motion. Deciding that
        in the module script below would be a decision taken after the first
        frame --- the prologue would flash up and vanish, which is worse than
        either state. Everyone else gets it on every load, including a reload:
        it is the page's front door, not a thing to be got past once. */}
    <script is:inline>
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.dataset.stage = "voyage";
      }
    </script>
    <meta
      name="description"
      content="Troy to Ithaca is a week under sail. Odysseus took twenty years. An interactive map of the detour, drawn to the poem's own arithmetic."
    />
    <title>Ten Years Late — Odysseus's detour</title>
  </head>
  <body>
    <header class="topbar">
      <nav aria-label="Primary">
        <a class="wordmark" href={base}>Ten Years Late</a>
      </nav>
      {/* Off by default and never autoplayed: a marked page that starts making
          noise is a page nobody hears twice. `preload="none"` keeps the 1.2MB
          off the first load entirely --- it is fetched when it is asked for. */}
      <div class="topbar-tools">
        <button
          type="button"
          class="sound"
          id="sound"
          aria-pressed="false"
          aria-label="Play the music"
        >
          <span class="sound-glyph" aria-hidden="true"></span>
          <span id="sound-label">Sound</span>
        </button>

        {/* Only offered once there is something to go back from. It returns
            the page to the harbour rather than sailing anything, so it says
            that and not "replay". */}
        <button type="button" class="restart" id="restart">
          Back to Troy
        </button>
      </div>
      <audio id="track" src={track} loop preload="none"></audio>

      {/* The benchmark and the voyage, side by side. The comparison is the
          adjacency --- neither line has to name the other for the gap between
          two numbers in the same column to read. */}
      <div class="counters">
        {/* Two readings of the same counter, both in the markup, swapped by
            the stage. The script writes only the first. Deciding between them
            in script instead would mean the arrived value flashing up for a
            frame on the paths that skip the crossing --- exactly the visitors
            who asked not to be flashed at. */}
        <p class="counter is-ghost">
          <span class="counter-k">Nostos</span>
          <span class="counter-v">
            <span class="at-sea" id="nostos-day">Day 0</span><span class="at-home"
              >Day {NOSTOS_DAYS}</span
            >
          </span>
          <span class="counter-n">
            <span class="at-sea" id="nostos-note">at Troy</span><span
              class="at-home">home</span
            >
          </span>
        </p>
        <p class="counter is-actual">
          <span class="counter-k">Odysseus</span>
          <span class="counter-v" id="day-count">Day 0</span>
          <span class="counter-n" id="day-note">still at Troy</span>
        </p>
      </div>
    </header>

    <main>
      <h1 class="visually-hidden">
        Ten Years Late — an interactive map of Odysseus's detour
      </h1>

      <div class="stage">
        <div class="map" id="map">
          {/* Markers are positioned as a percentage of this box, so the box has
              to hold the coastline's own aspect ratio exactly. Let the SVG
              letterbox inside a differently-shaped parent and every marker
              drifts off its coastline. */}
          <div class="map-frame">
            {/* Before the coastline, so the land draws over it. */}
            <Seamarks />
            <Fragment set:html={coastline} />
            {/* After the land, so the names sit on it as they do on a chart. */}
            <Placenames />
            <svg
              class="route"
              viewBox={`0 0 ${MAP_W} ${MAP_H}`}
              aria-hidden="true"
              focusable="false"
            >
              {/* Two copies of the same line. The faint dashed one is the whole
                  voyage; the solid one is drawn in behind the ship by pulling
                  its dash offset back, so what has been sailed and what has
                  not are different marks rather than different colours. */}
              <polyline id="route-whole" points={route} />
              <polyline id="route-sailed" points={route} />
            </svg>

            {/* The nostos, on its own layer so it can be drawn in and left
                standing while the voyage below it is redrawn from scratch.
                Under the real route in the stack: the voyage is the subject,
                and this is the measure held up against it. */}
            <svg
              class="route route-nostos"
              viewBox={`0 0 ${MAP_W} ${MAP_H}`}
              aria-hidden="true"
              focusable="false"
            >
              <polyline id="nostos-line" points={nostosRoute} />
            </svg>

            {/* The ship rides the route by transform, in pixels, so moving it
                never touches layout. Decorative: the panel and the counters
                carry the same information as text. */}
            <svg
              class="ship"
              id="ship"
              viewBox="0 0 40 26"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M2 15 L38 15 L33 22 L7 22 Z M19 15 L19 3 L20 3 L20 15 Z M20 4 L31 8 L20 12 Z"
              ></path>
            </svg>

            {/* The same hull, sailing the crossing that should have happened.
                It is solid while it is under way and drains to a shade once it
                moors, which is the only time it ever moves. */}
            <svg
              class="ship ship-nostos"
              id="nostos-ship"
              viewBox="0 0 40 26"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M2 15 L38 15 L33 22 L7 22 Z M19 15 L19 3 L20 3 L20 15 Z M20 4 L31 8 L20 12 Z"
              ></path>
            </svg>

            <div class="markers" role="group" aria-label="Voyage stops">
              {
                markers.map((m) => (
                  <button
                    class:list={[
                      "marker",
                      // The two ends of the voyage are the only stops the
                      // prologue shows, so they are the only ones that need
                      // naming in the markup.
                      { "is-start": m.index === 0 },
                      { "is-end": m.index === markers.length - 1 },
                    ]}
                    type="button"
                    data-index={m.index}
                    aria-pressed="false"
                    aria-label={`Stop ${m.index + 1}, ${m.name}`}
                    style={`left:${m.marker.x}%;top:${m.marker.y}%;--i:${m.index}`}
                  >
                    <span class="marker-dot">{m.index + 1}</span>
                    <span class="marker-name">{m.name}</span>
                    {/* Troy is the only control the prologue offers, so it
                        says what pressing it does rather than what it is. */}
                    {m.index === 0 && (
                      <span class="marker-cta">Sail for Ithaca</span>
                    )}
                  </button>
                ))
              }
            </div>
          </div>

          {/* Outside the frame, so the controls do not zoom with the map. */}
          <div class="map-controls">
            <button type="button" id="zoom-in" aria-label="Zoom in">+</button>
            <button type="button" id="zoom-out" aria-label="Zoom out">−</button>
            <button type="button" id="zoom-fit" aria-label="Show the whole map">
              Fit
            </button>
          </div>
          <p class="map-hint" id="map-hint">
            Scroll to zoom, drag to pan. Plus and minus zoom, Escape fits.
          </p>

          {/* A way past the prologue for anyone who does not want to watch it.
              It names where it goes rather than what it refuses. */}
          <button type="button" class="skip" id="skip">Go to the voyage</button>
        </div>

        <aside class="panel" id="scene" aria-live="polite">
          {/* What the page is measuring, before it measures anything. It is in
              the markup at load rather than announced, so the live region has
              nothing to read out until the voyage actually arrives. */}
          <div class="panel-prologue">
            <p class="panel-meta">
              <span class="panel-book">The voyage that should have happened</span>
            </p>
            <h2 class="panel-title">Nostos</h2>
            <p class="panel-epithet">νόστος — the return home by sea</p>
            <p class="panel-blurb">
              Every Greek captain turned for home out of the same harbour on the
              same day. Troy to Ithaca is about five hundred miles of open
              water — a week under sail at the speed an ancient fleet was
              actually recorded making.
            </p>
            <p class="panel-blurb">
              So this is that week. Fair weather the whole way, a following
              wind, and no god with a grievance: the Cyclops still has both his
              eyes, and Poseidon has not yet been given the reason he was given.
              Odysseus reaches Ithaca on day seven and the poem is four hundred
              lines long.
            </p>
            <p class="panel-days">What happened instead comes afterwards.</p>
          </div>

          <div class="panel-scene">
            <p class="panel-meta">
              <span class="panel-num" id="scene-num">1</span>
              <span class="panel-book" id="scene-book">Book 9</span>
            </p>
            <h2 class="panel-title" id="scene-title">Troy</h2>
            <p class="panel-epithet" id="scene-epithet">
              Twelve ships turn for home
            </p>
            <p class="panel-blurb" id="scene-blurb"></p>
            <p class="panel-days" id="scene-days"></p>
          </div>
        </aside>
      </div>

      <div class="rail">
        {/* Two lanes over one control.

            The lane above is the calendar: every stop drawn at the width the
            poem gives it. The controls below stay evenly spaced, because six
            of the stops fall inside the first fifty days and a rail drawn to
            scale would stack them into one unclickable point.

            The leaders between the lanes are the argument. The voyage everyone
            remembers is the even one; the calendar is what the poem counts.
            The distance between a stop's two positions is the distance between
            those two things. */}
        <div class="calendar" aria-hidden="true">
          <div class="cal-track" id="cal-track"></div>
          <svg
            class="leaders"
            id="leaders"
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
          >
            <path id="leader-path"></path>
          </svg>
        </div>

        <label class="visually-hidden" for="timeline">
          Voyage stop — drag or use the arrow keys
        </label>
        {/* The stops sit on the line the voyage runs along rather than on a
            row of their own beneath it. Inert, and deliberately so: the slider
            underneath is the control, and pressing it anywhere already goes to
            the nearest stop, so a bead that could also be pressed would be a
            second control doing the first one's job. */}
        <div class="rail-line">
          <input
            type="range"
            id="timeline"
            min="0"
            max={STOPS.length - 1}
            step="any"
            value="0"
          />
          <div class="rail-nodes" aria-hidden="true">
            {markers.map((m) => <span class="rail-node" data-index={m.index} />)}
          </div>
        </div>

        <div class="rail-ticks" aria-hidden="true">
          {
            markers.map((m) => (
              <span class="rail-tick" data-index={m.index}>
                <span class="rail-label">{m.name}</span>
              </span>
            ))
          }
        </div>
        <p class="rail-foot">
          <button type="button" class="scale-toggle" id="scale-toggle" aria-pressed="false">
            <span class="scale-dot"></span>
            <span id="scale-label">Story order</span>
          </button>
          {/* The licence the music ships under requires attribution, so it is
              on the page. It lives here rather than over the map because the
              map's own corner is hidden on a phone, and an attribution only
              some visitors can see is not one. */}
          <span class="credit">
            <em>Temple of the Manes</em> by Kevin MacLeod, <a
              href="https://creativecommons.org/licenses/by/4.0/"
              rel="license noopener"
              target="_blank">CC BY 4.0</a
            >
          </span>
        </p>
      </div>
    </main>

    <script>
      import {
        NOSTOS_DAYS,
        STOPS,
        calendarSpan,
        dayAt,
        nostosRoutePoints,
        routePoints,
        storyPosition,
        voyageDayAt,
      } from "../data/voyage.ts";

      const timeline = document.querySelector<HTMLInputElement>("#timeline")!;
      const markers = [
        ...document.querySelectorAll<HTMLButtonElement>(".marker"),
      ];
      const ticks = [...document.querySelectorAll<HTMLElement>(".rail-tick")];
      const nodes = [...document.querySelectorAll<HTMLElement>(".rail-node")];
      // One axis for the label column and the bead on the line, so a stop is
      // at the same x in both.
      [ticks, nodes].forEach((row) =>
        row.forEach((el, i) => {
          el.style.left = `${(i / (STOPS.length - 1)) * 100}%`;
        }),
      );
      const frame = document.querySelector<HTMLElement>(".map-frame")!;
      const ship = document.querySelector<SVGSVGElement>("#ship")!;
      const sailed = document.querySelector<SVGPolylineElement>("#route-sailed")!;
      const unsailed =
        document.querySelector<SVGPolylineElement>("#route-whole")!;
      const panel = document.querySelector<HTMLElement>("#scene")!;
      const map = document.querySelector<HTMLElement>("#map")!;
      const markerLayer = document.querySelector<HTMLElement>(".markers")!;
      const nostosShip = document.querySelector<SVGSVGElement>("#nostos-ship")!;
      const nostosLine =
        document.querySelector<SVGPolylineElement>("#nostos-line")!;
      const clay = document.querySelector<SVGPatternElement>("#clay-ground")!;

      // Names arrive as the map is zoomed into them. Eleven of the fifteen sit
      // in the Aegean and the Peloponnese, which is more lettering than that
      // corner holds at the whole-map view; the regions stay, because the east
      // looking named against a blank west is the point.
      const namesByZoom = [
        ...document.querySelectorAll<SVGTextElement>(".placenames text[data-from]"),
      ].map((el) => ({ el, from: Number(el.dataset.from) }));

      const el = (id: string) => document.getElementById(id)!;

      /**
       * The day the voyage stands at: the poem's count where it has one and a
       * crossing's sailing time where it does not.
       *
       * Six of the fourteen stops are given a duration and eight are not. A
       * counter of stated days alone therefore stands still through more than
       * half the journey --- correct, and it reads as a fault. This one moves
       * wherever the visitor goes, and never counts a stretch of sea twice:
       * see voyageDayAt.
       */
      const DAYS = STOPS.map((_, i) => voyageDayAt(i));

      const stillness = window.matchMedia("(prefers-reduced-motion: reduce)");

      /**
       * The route, and its length, in the space it is drawn in --- the map's
       * own 1600 x 953.8 box.
       *
       * Not in screen pixels, which is where this used to live. Screen pixels
       * meant the dash arithmetic had to know the zoom, and knowing the zoom
       * meant depending on whether a non-scaling stroke's dash pattern follows
       * an ancestor's CSS transform. Chrome says it does, WebKit says it does
       * not, so either answer was wrong on one of them --- solid dashes on
       * Chrome uncompensated, solid dashes on iPad compensated. In plain user
       * units there is nothing left to disagree about.
       */
      const MAP_W = 1600;
      const MAP_H = 953.8;
      const { points: ROUTE, stopAt: STOP_AT } = routePoints();

      interface Point {
        x: number;
        y: number;
      }

      /**
       * A sampled course, measured so it can be walked by distance.
       *
       * Both courses on the map go through this: the voyage and the nostos.
       * Walking by length rather than by sample index is what keeps a ship at
       * a steady speed --- the curve is sampled evenly in its parameter, not
       * in distance, so a long leg and a short one carry the same number of
       * samples and stepping by index would sprint the long ones.
       */
      interface Course {
        points: Point[];
        cum: number[];
        length: number;
        /** The point at a given distance along the course. */
        at: (length: number) => Point;
      }

      function measure(points: Point[]): Course {
        const cum = points.reduce<number[]>((acc, point, i) => {
          if (i === 0) return [0];
          const previous = points[i - 1]!;
          return [
            ...acc,
            acc[i - 1]! +
              Math.hypot(
                ((point.x - previous.x) / 100) * MAP_W,
                ((point.y - previous.y) / 100) * MAP_H,
              ),
          ];
        }, []);

        const at = (length: number): Point => {
          let lo = 0;
          let hi = cum.length - 1;
          while (lo < hi - 1) {
            const mid = (lo + hi) >> 1;
            if (cum[mid]! <= length) lo = mid;
            else hi = mid;
          }
          const span = cum[hi]! - cum[lo]!;
          const t = span === 0 ? 0 : (length - cum[lo]!) / span;
          const a = points[lo]!;
          const b = points[hi]!;
          return { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t };
        };

        return { points, cum, length: cum[cum.length - 1]!, at };
      }

      const VOYAGE = measure(ROUTE);
      const NOSTOS = measure(nostosRoutePoints());
      const CUM = VOYAGE.cum;
      const ROUTE_LENGTH = VOYAGE.length;

      /**
       * Zoom and pan.
       *
       * The whole picture is one element, so this is three numbers: a scale and
       * a translation, applied to `.map-frame` with its origin at the top left.
       * A frame point p lands at `offset + t + z * p`, where `offset` is where
       * the centred frame sits inside the map's clip box.
       *
       * Two decisions worth naming. The auto-zoom is deliberately shallow ---
       * a stop is worth a closer look, but the page's argument is a shape you
       * can only see whole, the lettered east against the empty west where all
       * fourteen stops sit, and a tight zoom throws that away. And the view is
       * clamped so the frame always covers the window: a map that can be
       * dragged off into blank space feels broken, however correct the maths.
       */
      const AUTO_ZOOM = 2.2;
      const MAX_ZOOM = 6;

      let z = 1;
      let tx = 0;
      let ty = 0;

      /** How much of the nostos has been sailed, 0 to 1. It only ever rises. */
      let nostosProgress = 0;

      /** True while the voyage is being drawn onto the map for the first time. */
      let revealing = false;

      // The first paint is the whole map on purpose. The page's argument is a
      // shape --- the lettered east against the empty west where every stop
      // sits --- and it has to be seen once before anything zooms into it.
      let hasSelected = false;

      const frameBox = () => ({ w: frame.clientWidth, h: frame.clientHeight });

      /** Where the centred frame's top left sits inside the map's clip box. */
      function offset() {
        const f = frameBox();
        return {
          x: (map.clientWidth - f.w) / 2,
          y: (map.clientHeight - f.h) / 2,
        };
      }

      function clampView() {
        const f = frameBox();
        const off = offset();
        const fit = (
          t: number,
          span: number,
          window: number,
          o: number,
        ): number => {
          const scaled = span * z;
          // Too small to fill the window on this axis: centre it instead of
          // letting it drift to an edge.
          if (scaled <= window) return (window - scaled) / 2 - o;
          return Math.max(window - o - scaled, Math.min(-o, t));
        };
        tx = fit(tx, f.w, map.clientWidth, off.x);
        ty = fit(ty, f.h, map.clientHeight, off.y);
      }

      function applyView(duration = 480) {
        clampView();
        frame.style.transitionDuration = stillness.matches ? "0ms" : `${duration}ms`;
        frame.style.transform = `translate(${tx}px, ${ty}px) scale(${z})`;
        frame.style.setProperty("--z", String(z));
        map.classList.toggle("is-zoomed", z > 1.001);

        // The clay tooth is a surface, not a feature of the terrain: left to
        // scale it stops being tooth at about 1.5x and becomes polka dots.
        clay.setAttribute("patternTransform", `scale(${1 / z})`);
        for (const name of namesByZoom) {
          name.el.classList.toggle("is-held", z < name.from - 0.001);
        }
        drawShip(progress);
        drawNostos(nostosProgress);
      }

      /** Put a point of the frame, in percent, at the centre of the window. */
      function centreOn(xPercent: number, yPercent: number, scale: number) {
        const f = frameBox();
        const off = offset();
        z = scale;
        tx = map.clientWidth / 2 - off.x - (z * xPercent * f.w) / 100;
        ty = map.clientHeight / 2 - off.y - (z * yPercent * f.h) / 100;
      }

      /** Zoom about a point given in client coordinates, keeping it fixed. */
      function zoomAbout(clientX: number, clientY: number, next: number) {
        const box = map.getBoundingClientRect();
        const off = offset();
        const px = clientX - box.left - off.x - tx;
        const py = clientY - box.top - off.y - ty;
        const ratio = next / z;
        tx -= px * (ratio - 1);
        ty -= py * (ratio - 1);
        z = next;
        applyView(0);
      }

      const clampZoom = (value: number) => Math.min(MAX_ZOOM, Math.max(1, value));

      function fitMap() {
        z = 1;
        tx = 0;
        ty = 0;
        applyView();
      }

      /**
       * How far along the drawn line the ship is, for a fractional position in
       * the stop list.
       */
      function lengthAt(progress: number): number {
        const i = Math.max(0, Math.min(STOPS.length - 2, Math.floor(progress)));
        const t = Math.max(0, Math.min(1, progress - i));
        const from = CUM[STOP_AT[i]!]!;
        const to = CUM[STOP_AT[i + 1]!]!;
        return from + (to - from) * t;
      }

      /**
       * Put a hull at a distance along a course, pointing the way it is going.
       *
       * Shared by the voyage and the nostos, because a ship that reads as a
       * ship on one line and as a capsized wreck on the other would give the
       * comparison away as two pieces of code rather than one picture.
       */
      function placeShip(
        el: SVGSVGElement,
        course: Course,
        travelled: number,
        box: { w: number; h: number },
      ): Point {
        const here = course.at(travelled);

        // Heading from a fixed distance along the line rather than a fixed
        // step in progress: near a tight bend the two are not the same, and a
        // progress step gives a bow that swings before the ship turns.
        const step = course.length * 0.004;
        const ahead = course.at(Math.min(course.length, travelled + step));
        const behind = course.at(Math.max(0, travelled - step));

        // The frame is wider than it is tall and the route's user space is
        // stretched to match, so the heading has to be worked out in pixels.
        // Taking it from percentages points the bow at the wrong horizon.
        const angle =
          (Math.atan2(
            (ahead.y - behind.y) * box.h,
            (ahead.x - behind.x) * box.w,
          ) *
            180) /
          Math.PI;

        // A ship has an up. Rotating a west-bound heading past ninety degrees
        // turns the whole boat over and stands the mast on the sea floor, so
        // anything heading left is mirrored and rotated back instead --- the
        // bow still points along the course, and the mast still points at the
        // sky.
        const westbound = Math.abs(angle) > 90;
        const heading = westbound ? angle - 180 : angle;
        const mirror = westbound ? " scale(-1, 1)" : "";

        el.style.transform = `translate(${(here.x / 100) * box.w}px, ${
          (here.y / 100) * box.h
        }px) translate(-50%, -50%) rotate(${heading}deg)${mirror} scale(${1 / z})`;

        return here;
      }

      /** One user unit in device pixels, at the current zoom. */
      const unitSize = (box: { w: number; h: number }) =>
        (box.w / MAP_W) * z;

      function drawShip(progress: number): { x: number; y: number } | null {
        // Layout size, not the bounding rect: the ship is a child of the frame
        // and already inherits its zoom, so measuring the *scaled* box would
        // apply the scale twice and fling the ship off the map.
        const box = frameBox();
        if (box.w === 0) return null;

        const travelled = lengthAt(progress);
        const here = placeShip(ship, VOYAGE, travelled, box);

        // Widths and dashes are stated in user units and converted here, so a
        // line keeps the same thickness on screen at every zoom without asking
        // any vector-effect to arrange it.
        const unit = unitSize(box);
        sailed.style.strokeWidth = String(1.4 / unit);
        unsailed.style.strokeWidth = String(1.5 / unit);

        // The reveal owns both dash patterns while it runs: it is drawing the
        // whole voyage out of Troy, and the voyage's own idea of how much has
        // been sailed is zero. Letting this write through would erase the
        // stroke a frame after it was drawn.
        if (!revealing) {
          sailed.style.strokeDasharray = String(ROUTE_LENGTH);
          sailed.style.strokeDashoffset = String(ROUTE_LENGTH - travelled);
          unsailed.style.strokeDasharray = `${4 / unit} ${6 / unit}`;
        }

        // The rail's filled track is the same fact as the drawn-in route, so
        // it is driven from the same number rather than from the input's value.
        timeline.style.setProperty(
          "--sailed",
          `${(progress / (STOPS.length - 1)) * 100}%`,
        );

        return here;
      }

      /**
       * The nostos, at a fraction of its own crossing.
       *
       * Drawn from the same numbers as the voyage below it --- same units,
       * same dash arithmetic --- so the two lines answer to a zoom identically
       * and neither can go solid on one engine while the other stays dashed.
       */
      function drawNostos(fraction: number): void {
        const box = frameBox();
        if (box.w === 0) return;

        const travelled = NOSTOS.length * Math.max(0, Math.min(1, fraction));
        placeShip(nostosShip, NOSTOS, travelled, box);

        const unit = unitSize(box);
        nostosLine.style.strokeWidth = String(1.3 / unit);
        nostosLine.style.strokeDasharray = String(NOSTOS.length);
        nostosLine.style.strokeDashoffset = String(NOSTOS.length - travelled);
      }

      /**
       * How far past the nostos the voyage is standing, in words.
       *
       * It does not name what it is behind. The nostos counter is directly
       * beside this one, so the comparison is the adjacency of two numbers in
       * the same column --- saying "behind the nostos" here would make the
       * words repeat what the layout already does.
       */
      function describeLag(day: number): string {
        const behind = day - NOSTOS_DAYS;
        if (behind <= 0) return "still on schedule";
        if (behind < 90) return `${behind} days later`;
        const plural = (n: number, unit: string) =>
          `${n} ${unit}${n === 1 ? "" : "s"}`;
        const years = Math.floor(behind / 365);
        const months = Math.round((behind % 365) / 30);
        if (years < 1) return `${plural(months, "month")} later`;
        const y = plural(years, "year");
        return months ? `${y} ${plural(months, "month")} later` : `${y} later`;
      }

      let current = -1;
      let progress = 0;
      let day = 0;
      let frameRequest = 0;

      /**
       * Sailing and staying are animated on two clocks, one after the other,
       * because that separation is the whole argument of the page.
       *
       * The ship crosses in about half a second wherever it is going --- the
       * distances are not the point. Then it sits still while the day counter
       * climbs the length of the stay, log-scaled so nine days is a blink and
       * Calypso's seven years is the longest thing on the page. The stop the
       * poem spends 85% of its counted time on is the one where nothing moves.
       */
      /**
       * How long a crossing takes, from how much sea it actually covers.
       *
       * This used to count stops jumped and cap at three, so Troy to Ithaca ---
       * the length of the Mediterranean --- took the same 660ms as a hop
       * between neighbours, and the camera tore across the map to keep up. The
       * fraction is of the whole drawn route, so a leg's real length sets its
       * clock.
       *
       * Square-rooted rather than linear: a crossing eight times longer should
       * feel longer, not take eight times the patience.
       */
      function travelTime(fraction: number): number {
        if (stillness.matches) return 0;
        // The floor is most of it. Even neighbouring stops are a sea crossing
        // --- the shortest leg on the map is still 1.8% of the route, about
        // ninety nautical miles --- and at anything under a second the ship
        // arrives before the eye has followed it out of the harbour. This is a
        // page about a journey taking longer than anyone expected; nothing on
        // it should snap.
        return 820 + 1450 * Math.sqrt(Math.min(1, fraction));
      }

      function dwellTime(days: number): number {
        if (stillness.matches || days <= 0) return 0;
        return Math.min(1500, 200 + 300 * Math.log10(1 + days));
      }

      const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

      function animateTo(index: number) {
        const fromProgress = progress;
        const fromDay = day;
        const toDay = Math.round(DAYS[index]!);
        // How much of the drawn route this crossing covers, which is what sets
        // both the clock below and how far the camera pulls back.
        const span =
          Math.abs(lengthAt(index) - lengthAt(fromProgress)) / ROUTE_LENGTH;
        const travel = travelTime(span);

        /**
         * The camera rides with the ship instead of panning to where it will
         * be.
         *
         * It used to be set once, to the destination, on a CSS transition of
         * the same length. At this zoom a long leg made the map tear past ---
         * the ship sailed one way and the view went another, and the two only
         * agreed again at the end. Following the hull frame by frame means the
         * movement on screen is the voyage rather than a camera chasing it.
         *
         * And it breathes out on the way: `dip` pulls the zoom back at the
         * middle of a long crossing and settles in again on arrival, so you
         * can see the water being crossed. A short hop barely moves it.
         */
        const following = hasSelected;
        const startZoom = z;
        const endZoom = Math.max(z, AUTO_ZOOM);
        const dip = span * (endZoom - 1) * 0.55;

        hasSelected = true;
        const dwell = dwellTime(Math.abs(toDay - fromDay));
        const started = performance.now();

        cancelAnimationFrame(frameRequest);

        const step = (now: number) => {
          const t = now - started;
          const sailing = travel === 0 ? 1 : Math.min(1, t / travel);
          const staying =
            dwell === 0 ? 1 : Math.min(1, Math.max(0, (t - travel) / dwell));

          progress = fromProgress + (index - fromProgress) * easeOut(sailing);
          day = Math.round(fromDay + (toDay - fromDay) * easeOut(staying));

          const here = drawShip(progress);
          if (!scrubbing) timeline.value = String(progress);
          if (following && here) {
            const eased = easeOut(sailing);
            // sin is zero at both ends and one in the middle, so the pull-back
            // is spent entirely on the crossing and nothing is left of it on
            // arrival.
            const breath = Math.sin(Math.PI * sailing) * dip;
            centreOn(
              here.x,
              here.y,
              Math.max(1, startZoom + (endZoom - startZoom) * eased - breath),
            );
            applyView(0);
          }

          el("day-count").textContent = `Day ${day.toLocaleString()}`;
          el("day-note").textContent =
            index === 0 && day === 0 ? "still at Troy" : describeLag(day);

          if (sailing < 1 || staying < 1) {
            frameRequest = requestAnimationFrame(step);
          }
        };

        frameRequest = requestAnimationFrame(step);
      }

      /**
       * Everything about a stop except the movement: the panel, the pressed
       * states, the announcement.
       *
       * Split out from `show` because a drag needs all of this and none of the
       * animation --- the finger is already providing the movement, and
       * restarting a crossing on every input event is what made scrubbing
       * judder.
       */
      function showText(index: number) {
        current = index;
        const stop = STOPS[index]!;

        // The reveal happens once, at the stop it is about: arriving at Ogygia
        // is where the retelling and the calendar come apart. It lives here
        // rather than with the crossing animation because a drag never runs
        // that --- scrubbing past Ogygia used to slide straight through the one
        // moment the lane exists for.
        if (index === OGYGIA && mixTarget < 0.5) setScale(1);

        // Restart the entrance animation rather than queueing one, so dragging
        // the timeline fast never leaves the panel mid-fade.
        panel.classList.remove("is-entering");
        void panel.offsetWidth;
        panel.classList.add("is-entering");

        el("scene-num").textContent = String(index + 1);
        el("scene-book").textContent = stop.book;
        el("scene-title").textContent = stop.name;
        el("scene-epithet").textContent = stop.epithet;
        el("scene-blurb").textContent = stop.blurb;

        el("scene-days").textContent =
          stop.days === null
            ? "The poem gives no duration for this stop."
            : stop.days === 0
              ? ""
              : `${stop.days.toLocaleString()} days — ${stop.daysNote}.`;
        el("scene-days").classList.toggle("is-gap", stop.days === null);

        markers.forEach((m, i) => {
          m.setAttribute("aria-pressed", String(i === index));
          m.classList.toggle("is-active", i === index);
          m.classList.toggle("is-past", i < index);
        });
        ticks.forEach((t, i) => {
          t.classList.toggle("is-active", i === index);
          t.classList.toggle("is-past", i < index);
        });
        // The bead only says whether the stop is behind you. Which one you are
        // at is the thumb sitting on top of it.
        nodes.forEach((n, i) => n.classList.toggle("is-past", i < index));
        marks.forEach(({ el: mark }, i) => {
          mark.classList.toggle("is-active", i === index);
          mark.classList.toggle("is-past", i < index);
        });

        // Announced from the arrival value, not the value the counter happens
        // to be rolling through: a screen reader should hear where the voyage
        // stands, not watch the animation.
        const arrival = Math.round(DAYS[index]!);
        timeline.setAttribute(
          "aria-valuetext",
          `Stop ${index + 1} of ${STOPS.length}, ${stop.name}. Day ${arrival.toLocaleString()}. ${describeLag(arrival)}.`,
        );
      }

      function show(index: number) {
        if (index === current) return;
        showText(index);
        // The thumb is not set here. `animateTo` walks it across with the ship,
        // so the rail crosses the distance rather than arriving first and
        // waiting for the map to catch up.
        animateTo(index);
      }

      // On a phone the rail is sticky at the bottom of a scrolling page, so
      // the panel's last line scrolls underneath it and is never reachable.
      // The rail's height is not a constant --- the labels wrap, the toggle
      // wraps --- so it publishes what it actually is and the panel reserves
      // exactly that.
      const rail = document.querySelector<HTMLElement>(".rail")!;
      // Border box, not `contentRect`: the rail's padding is part of what
      // covers the panel, and `contentRect` leaves it out.
      new ResizeObserver(() => {
        document.documentElement.style.setProperty(
          "--rail-space",
          `${rail.getBoundingClientRect().height}px`,
        );
      }).observe(rail);


      // ---------- zoom and pan ----------

      document.querySelector("#zoom-in")!.addEventListener("click", () => {
        zoomAbout(
          map.getBoundingClientRect().left + map.clientWidth / 2,
          map.getBoundingClientRect().top + map.clientHeight / 2,
          clampZoom(z * 1.5),
        );
      });

      document.querySelector("#zoom-out")!.addEventListener("click", () => {
        zoomAbout(
          map.getBoundingClientRect().left + map.clientWidth / 2,
          map.getBoundingClientRect().top + map.clientHeight / 2,
          clampZoom(z / 1.5),
        );
      });

      document.querySelector("#zoom-fit")!.addEventListener("click", fitMap);

      map.addEventListener(
        "wheel",
        (event) => {
          event.preventDefault();
          // Trackpad pinches arrive as ctrl+wheel with small deltas; a mouse
          // wheel arrives in coarse notches. One exponential handles both.
          const factor = Math.exp(-event.deltaY * (event.ctrlKey ? 0.01 : 0.002));
          zoomAbout(event.clientX, event.clientY, clampZoom(z * factor));
        },
        { passive: false },
      );

      // Pointer drag to pan, and two pointers to pinch. A drag only counts once
      // it passes a few pixels, so pressing a marker still selects it.
      const DRAG_SLOP = 7;
      const active = new Map<number, { x: number; y: number }>();
      let panning = false;
      let moved = 0;
      let pinchStart = 0;
      let pinchZoom = 1;

      const spread = () => {
        const [a, b] = [...active.values()];
        return a && b ? Math.hypot(a.x - b.x, a.y - b.y) : 0;
      };

      map.addEventListener("pointerdown", (event) => {
        // Reset on every press, not only when a pan starts: a stale distance
        // from the last drag would swallow the next click on a marker.
        moved = 0;
        active.set(event.pointerId, { x: event.clientX, y: event.clientY });
        if (active.size === 2) {
          pinchStart = spread();
          pinchZoom = z;
          panning = false;
          return;
        }
        // At full extent on a phone the page still has to scroll, so a single
        // finger is only taken over once there is something to pan.
        if (active.size === 1 && (z > 1.001 || event.pointerType === "mouse")) {
          panning = true;
        }
      });

      map.addEventListener("pointermove", (event) => {
        const previous = active.get(event.pointerId);
        if (!previous) return;
        const dx = event.clientX - previous.x;
        const dy = event.clientY - previous.y;
        active.set(event.pointerId, { x: event.clientX, y: event.clientY });

        if (active.size === 2 && pinchStart > 0) {
          const now = spread();
          const [a, b] = [...active.values()];
          if (!a || !b) return;
          zoomAbout(
            (a.x + b.x) / 2,
            (a.y + b.y) / 2,
            clampZoom((pinchZoom * now) / pinchStart),
          );
          return;
        }

        if (!panning) return;
        moved += Math.abs(dx) + Math.abs(dy);
        if (moved < DRAG_SLOP) return;

        // Capture only once the press has become a drag. Capturing on
        // pointerdown retargets the click that follows to the map, so pressing
        // a marker stopped selecting it.
        if (!map.hasPointerCapture(event.pointerId)) {
          map.setPointerCapture(event.pointerId);
        }
        map.classList.add("is-panning");
        tx += dx;
        ty += dy;
        applyView(0);
      });

      const endPointer = (event: PointerEvent) => {
        active.delete(event.pointerId);
        if (active.size < 2) pinchStart = 0;
        if (active.size === 0) {
          panning = false;
          map.classList.remove("is-panning");
        }
      };
      map.addEventListener("pointerup", endPointer);
      map.addEventListener("pointercancel", endPointer);

      // A marker press that turned into a drag should pan, not select.
      markers.forEach((m) =>
        m.addEventListener("click", (event) => {
          if (moved >= DRAG_SLOP) event.stopImmediatePropagation();
        }, true),
      );

      window.addEventListener("resize", () => applyView(0));

      // ---------- the calendar lane ----------

      /**
       * One lane, two scales, and a number between them.
       *
       * `mix` at 0 draws every stop at its position in the retelling --- evenly
       * spaced, which is how everyone remembers the voyage and how the controls
       * below are laid out. At 1 it draws them on a calendar: each stay as wide
       * as the days the poem gives it. Everything is interpolated between the
       * two, so the same code draws both ends and every frame of the collapse.
       *
       * The blocks and the leaders are drawn together in one pass rather than
       * left to CSS transitions, because they have to agree exactly: a leader
       * that arrives a frame after its block reads as a rendering fault, not
       * as an argument.
       */
      const track = document.querySelector<HTMLElement>("#cal-track")!;
      const leaderPath = document.querySelector<SVGPathElement>("#leader-path")!;
      const scaleToggle = document.querySelector<HTMLButtonElement>("#scale-toggle")!;
      const scaleLabel = document.querySelector<HTMLElement>("#scale-label")!;

      const SPANS = STOPS.map((_, i) => calendarSpan(i));
      const OGYGIA = STOPS.findIndex((stop) => stop.id === "ogygia");
      const STORY = STOPS.map((_, i) => storyPosition(i));

      // Every stop is the same kind of mark in the same colour. Width is the
      // only thing that varies, which is the whole point of the lane: a stop
      // the poem gives no length to collapses to nothing on the calendar, and
      // that is visible without a second colour having to mean it.
      const marks = STOPS.map((_, i) => {
        const el = document.createElement("span");
        el.className = "cal-block";
        el.dataset.index = String(i);
        // The target is the block, so it is exactly as big as the stay is
        // long. On the calendar that means Ogygia is most of the lane and a
        // stop the poem gives no duration to is a hairline you cannot really
        // hit --- which is the lane's whole argument, not a shortcoming of it.
        // Every stop stays reachable from the rail below and from the map.
        el.addEventListener("click", () => show(i));
        track.append(el);
        return { el };
      });

      let mix = 0;
      let mixTarget = 0;
      let mixFrame = 0;

      /** A stop's left edge and width on the lane, at the current blend. */
      function laneGeometry(i: number) {
        // In story order a stop is a point on an even rail; on the calendar it
        // is an interval. Blending between a point and an interval is what
        // makes the collapse read as one thing opening rather than two
        // pictures cross-fading.
        const evenStart = STORY[i]!;
        const evenEnd = i === 0 ? 0 : STORY[i - 1]!;
        const start = evenEnd + (SPANS[i]!.start - evenEnd) * mix;
        const end = evenStart + (SPANS[i]!.end - evenStart) * mix;
        return { start: start * 100, width: Math.max(0, end - start) * 100 };
      }

      function drawCalendar() {
        const leaders: string[] = [];
        marks.forEach(({ el }, i) => {
          const { start, width } = laneGeometry(i);
          el.style.left = `${start}%`;
          el.style.width = `${width}%`;
          // From the control below, which never moves, to where this stop
          // actually falls on the calendar above.
          leaders.push(`M${STORY[i]! * 100} 100L${start + width} 0`);
        });
        leaderPath.setAttribute("d", leaders.join(""));
      }

      function setScale(next: number, animated = true) {
        mixTarget = Math.max(0, Math.min(1, next));
        const showsCalendar = mixTarget > 0.5;
        scaleToggle.setAttribute("aria-pressed", String(showsCalendar));
        scaleLabel.textContent = showsCalendar ? "True calendar" : "Story order";

        if (!animated || stillness.matches) {
          mix = mixTarget;
          drawCalendar();
          return;
        }

        const from = mix;
        const started = performance.now();
        const duration = 900;
        cancelAnimationFrame(mixFrame);
        const step = (now: number) => {
          const t = Math.min(1, (now - started) / duration);
          mix = from + (mixTarget - from) * easeOut(t);
          drawCalendar();
          if (t < 1) mixFrame = requestAnimationFrame(step);
        };
        mixFrame = requestAnimationFrame(step);
      }

      scaleToggle.addEventListener("click", () =>
        setScale(mixTarget > 0.5 ? 0 : 1),
      );

      window.addEventListener("resize", drawCalendar);

      // Reduced motion gets the calendar from the start rather than a collapse
      // it cannot see: the fact matters more than the reveal.
      setScale(stillness.matches ? 1 : 0, false);

            // ---------- scrubbing ----------

      /**
       * Dragging the rail scrubs the voyage instead of stepping it.
       *
       * The control used to be `step="1"`, so a drag was fourteen jumps and
       * every one of them restarted the crossing animation from wherever the
       * last had got to. It is continuous now: the position under the thumb is
       * the ship's position, the day counter reads between the two stops it
       * falls between, and the panel shows whichever stop is nearest. Nothing
       * is animated while a finger is down --- the finger is the animation.
       *
       * The camera follows, because the interesting thing about scrubbing is
       * watching the ship cross. It follows on a 90ms transition rather than
       * instantly: at zero the map twitches on every input event, and at the
       * 480ms the rest of the view uses it lags behind the thumb. Ninety reads
       * as a camera with a little weight.
       */
      const SCRUB_FOLLOW_MS = 90;
      let scrubbing = false;

      /** Keep the ship in the middle of the window while the thumb moves. */
      function followShip(point: { x: number; y: number } | null) {
        if (!point) return;
        centreOn(point.x, point.y, Math.max(z, AUTO_ZOOM));
        applyView(SCRUB_FOLLOW_MS);
      }

      function dayBetween(value: number): number {
        const i = Math.max(0, Math.min(STOPS.length - 2, Math.floor(value)));
        const t = Math.max(0, Math.min(1, value - i));
        return Math.round(DAYS[i]! + (DAYS[i + 1]! - DAYS[i]!) * t);
      }

      function scrubTo(value: number) {
        cancelAnimationFrame(frameRequest);
        progress = value;
        day = dayBetween(value);
        followShip(drawShip(progress));
        el("day-count").textContent = `Day ${day.toLocaleString()}`;
        el("day-note").textContent =
          day === 0 ? "still at Troy" : describeLag(day);

        const nearest = Math.round(value);
        if (nearest !== current) showText(nearest);
      }

      /**
       * A press is not a drag until it moves.
       *
       * `pointerdown` used to start scrubbing outright, which meant a plain
       * click on the rail --- the most obvious way to go to a stop --- ran
       * `scrubTo` and set the position instantly. The ship teleported, and no
       * amount of tuning `travelTime` touched it, because a click never
       * reached `animateTo` at all. A press that never moves is a click now,
       * and gets the crossing.
       */
      const SCRUB_SLOP = 4;
      let pressing = false;
      let pressX = 0;

      timeline.addEventListener("pointerdown", (event) => {
        pressing = true;
        scrubbing = false;
        pressX = event.clientX;
        hasSelected = true;
      });

      timeline.addEventListener("pointermove", (event) => {
        if (!pressing || scrubbing) return;
        if (Math.abs(event.clientX - pressX) < SCRUB_SLOP) return;
        scrubbing = true;
        // Enter the following zoom as the drag begins, so it starts from the
        // scale it is going to stay at rather than jumping into it a frame
        // later.
        followShip(drawShip(progress));
        scrubTo(timeline.valueAsNumber);
      });

      timeline.addEventListener("input", () => {
        if (scrubbing) {
          scrubTo(timeline.valueAsNumber);
          return;
        }
        if (pressing) {
          // The browser has already thrown the thumb to the press point. Put
          // it back on the ship and let the crossing carry it across, so the
          // rail shows the journey the map is showing rather than arriving
          // first and waiting.
          timeline.value = String(progress);
          return;
        }
        show(Math.round(timeline.valueAsNumber));
      });

      const release = (event: PointerEvent | Event) => {
        if (!pressing) return;
        const wasScrubbing = scrubbing;
        pressing = false;
        scrubbing = false;

        // A click reads its target off where the pointer landed, because the
        // value was put back on the ship while the press was held.
        const index = wasScrubbing
          ? Math.round(timeline.valueAsNumber)
          : indexAt(event);
        if (wasScrubbing) {
          timeline.value = String(index);
          current = -1;
        }
        show(index);
      };

      /** Which stop a press at this x is nearest to. */
      function indexAt(event: PointerEvent | Event): number {
        const box = timeline.getBoundingClientRect();
        const x = "clientX" in event ? (event as PointerEvent).clientX : 0;
        const inset = 7; // half a thumb: the track the value maps onto
        const across =
          (x - box.left - inset) / Math.max(1, box.width - inset * 2);
        return Math.max(
          0,
          Math.min(STOPS.length - 1, Math.round(across * (STOPS.length - 1))),
        );
      }

      timeline.addEventListener("pointerup", release);
      timeline.addEventListener("pointercancel", release);

      // `step="any"` makes the arrow keys move by a hair, which is useless on a
      // control whose values are fourteen places. They move by whole stops.
      timeline.addEventListener("keydown", (event) => {
        const moves: Record<string, number> = {
          ArrowRight: current + 1,
          ArrowUp: current + 1,
          ArrowLeft: current - 1,
          ArrowDown: current - 1,
          Home: 0,
          End: STOPS.length - 1,
        };
        const next = moves[event.key];
        if (next === undefined) return;
        event.preventDefault();
        show(Math.max(0, Math.min(STOPS.length - 1, next)));
      });


      markers.forEach((m, i) => m.addEventListener("click", () => show(i)));
      ticks.forEach((t, i) => t.addEventListener("click", () => show(i)));

      // The map itself answers to the keyboard, so a visitor who tabs to a
      // marker can walk the whole voyage without going back to the slider.
      document.querySelector("#map")!.addEventListener("keydown", (event) => {
        const e = event as KeyboardEvent;
        const moves: Record<string, number> = {
          ArrowRight: current + 1,
          ArrowDown: current + 1,
          ArrowLeft: current - 1,
          ArrowUp: current - 1,
          Home: 0,
          End: STOPS.length - 1,
        };
        if (e.key === "Escape" || e.key === "0") {
          e.preventDefault();
          fitMap();
          return;
        }
        if (e.key === "+" || e.key === "=" || e.key === "-") {
          e.preventDefault();
          const box = map.getBoundingClientRect();
          zoomAbout(
            box.left + map.clientWidth / 2,
            box.top + map.clientHeight / 2,
            clampZoom(e.key === "-" ? z / 1.5 : z * 1.5),
          );
          return;
        }
        if (e.shiftKey && e.key.startsWith("Arrow")) {
          e.preventDefault();
          const step = 60;
          if (e.key === "ArrowLeft") tx += step;
          if (e.key === "ArrowRight") tx -= step;
          if (e.key === "ArrowUp") ty += step;
          if (e.key === "ArrowDown") ty -= step;
          applyView(0);
          return;
        }

        const next = moves[e.key];
        if (next === undefined) return;
        e.preventDefault();
        const clamped = Math.max(0, Math.min(STOPS.length - 1, next));
        show(clamped);
        markers[clamped]!.focus();
      });

      // ---------- sound ----------

      // Faded in and out rather than switched: an ancient modal piece cutting
      // in at full volume is a jump-scare.
      const audio = document.querySelector<HTMLAudioElement>("#track")!;
      const soundButton = document.querySelector<HTMLButtonElement>("#sound")!;
      const soundLabel = document.querySelector<HTMLElement>("#sound-label")!;
      const VOLUME = 0.34;
      let fade = 0;

      function rampTo(target: number, done?: () => void) {
        cancelAnimationFrame(fade);
        const from = audio.volume;
        const started = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - started) / 700);
          audio.volume = from + (target - from) * t;
          if (t < 1) fade = requestAnimationFrame(step);
          else done?.();
        };
        fade = requestAnimationFrame(step);
      }

      soundButton.addEventListener("click", async () => {
        const playing = soundButton.getAttribute("aria-pressed") === "true";
        if (playing) {
          rampTo(0, () => audio.pause());
          soundButton.setAttribute("aria-pressed", "false");
          soundButton.setAttribute("aria-label", "Play the music");
          soundLabel.textContent = "Sound";
          return;
        }
        audio.volume = 0;
        try {
          await audio.play();
        } catch {
          // Blocked, or the file could not be fetched. The page is silent and
          // everything else on it still works, so say nothing and stay off.
          return;
        }
        soundButton.setAttribute("aria-pressed", "true");
        soundButton.setAttribute("aria-label", "Stop the music");
        soundLabel.textContent = "Sound on";
        rampTo(VOLUME);
      });

      // ---------- the prologue ----------

      /**
       * Four stages, one attribute, and the page reads differently in each.
       *
       * The argument of this page is a comparison, and a comparison asserted
       * in a corner is not felt. So the benchmark is sailed before it is
       * quoted: the visitor sends a ship from Troy, watches it make Ithaca in
       * a week, and only then does the voyage that actually happened arrive
       * underneath it. By the time the big number appears, the small one it is
       * being measured against is something they caused.
       *
       *   prologue  Troy and Ithaca, and one control: Troy
       *   sailing   the crossing, and a way past it
       *   arrived   the ship moored, the count stopped
       *   voyage    everything, and the nostos left standing as the measure
       */
      type Stage = "prologue" | "sailing" | "arrived" | "voyage";

      const root = document.documentElement;
      const stage = () => (root.dataset.stage ?? "voyage") as Stage;
      const setStage = (next: Stage) => {
        root.dataset.stage = next;
      };

      /** Accelerates out of the harbour, decelerates into the island. */
      const easeInOut = (t: number) =>
        t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

      const CROSSING_MS = 4500;
      const MOORING_MS = 600;
      let crossingFrame = 0;

      /**
       * Frame the crossing before it is sailed.
       *
       * Worked out from the course itself rather than typed in, so moving a
       * sea mark cannot leave the camera pointing at the wrong sea. The target
       * is the course filling about three fifths of the window --- close
       * enough that a week's sailing is a real distance on screen, wide enough
       * that Cape Malea and both ends are in frame at once.
       */
      const COURSE_FILLS = 0.62;

      function frameNostos() {
        const xs = NOSTOS.points.map((p) => p.x);
        const ys = NOSTOS.points.map((p) => p.y);
        const minX = Math.min(...xs);
        const maxX = Math.max(...xs);
        const minY = Math.min(...ys);
        const maxY = Math.max(...ys);

        // The course's span is a percentage of the *frame*, and the frame is
        // not the window --- it is letterboxed inside the map's box on
        // whichever axis is not limiting. So the zoom has to be worked out
        // against both boxes. Treating the two as one is what put the camera
        // half as wide as intended on a tall window and looked correct on a
        // short one.
        const f = frameBox();
        if (f.w === 0) return;
        const fit = Math.min(
          (COURSE_FILLS * map.clientWidth) / (((maxX - minX) / 100) * f.w),
          (COURSE_FILLS * map.clientHeight) / (((maxY - minY) / 100) * f.h),
        );

        centreOn((minX + maxX) / 2, (minY + maxY) / 2, clampZoom(fit));
        applyView(0);
      }

      /** Only Troy answers during the prologue. */
      function lockToPrologue() {
        markers.forEach((m, i) => {
          m.disabled = i !== 0;
        });
        timeline.disabled = true;
        markers[0]!.setAttribute("aria-label", "Sail for Ithaca");
      }

      function unlock() {
        markers.forEach((m, i) => {
          m.disabled = false;
          m.setAttribute("aria-label", `Stop ${i + 1}, ${STOPS[i]!.name}`);
        });
        timeline.disabled = false;
      }

      function sailNostos() {
        if (stage() !== "prologue") return;
        setStage("sailing");
        el("nostos-note").textContent = "under way";

        const started = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - started) / CROSSING_MS);
          nostosProgress = easeInOut(t);
          drawNostos(nostosProgress);

          // The counter is read off the ship's own position, so the number and
          // the movement are the same fact rather than two things timed to
          // agree.
          el("nostos-day").textContent =
            `Day ${Math.round(nostosProgress * NOSTOS_DAYS)}`;

          if (t < 1) crossingFrame = requestAnimationFrame(step);
          else moor();
        };
        crossingFrame = requestAnimationFrame(step);
      }

      /** The ship touches Ithaca. Let it land before anything else happens. */
      function moor() {
        setStage("arrived");
        // The counter swaps to its settled reading and the hull drains to a
        // shade, both on CSS transitions the stage change starts. Nothing else
        // happens for a beat: an arrival that is immediately talked over is
        // not an arrival.
        window.setTimeout(reveal, MOORING_MS);
      }

      /**
       * The voyage arrives.
       *
       * Three things happen at once and none of them is a crossfade. The
       * camera pulls back until the whole basin is on screen, which is when
       * the blank western half opens up under the lettering. The course draws
       * itself out of Troy across that blank --- its own length is the
       * argument, so it is drawn rather than faded in, and drawn as one bright
       * stroke that hands over to the chart's dashes once it has arrived. And
       * the twelve stops the prologue withheld rise into place behind it, in
       * the order they were reached.
       */
      const REVEAL_CAMERA_MS = 900;
      const REVEAL_ROUTE_MS = 1150;
      const REVEAL_STAGGER_MS = 45;
      const REVEAL_HANDOVER_MS = 340;

      function reveal() {
        cancelAnimationFrame(crossingFrame);
        nostosProgress = 1;
        drawNostos(1);
        setStage("voyage");
        unlock();

        // The panel already holds Troy from the prologue; this re-runs its
        // entrance so it arrives with everything else rather than being found
        // already there.
        current = -1;
        showText(0);

        // The whole basin has now been seen once, which is the only thing the
        // opening view was protecting. From here a stop is worth going in for,
        // so the first click behaves like every click after it.
        hasSelected = true;

        if (stillness.matches) {
          markerLayer.classList.remove("is-arriving");
          fitMap();
          return;
        }

        z = 1;
        tx = 0;
        ty = 0;
        applyView(REVEAL_CAMERA_MS);

        markerLayer.classList.add("is-arriving");
        window.setTimeout(
          () => markerLayer.classList.remove("is-arriving"),
          STOPS.length * REVEAL_STAGGER_MS + 600,
        );

        drawRoute();
      }

      /** The whole course, drawn out of Troy as one stroke. */
      function drawRoute() {
        revealing = true;
        unsailed.style.opacity = "0";
        sailed.style.opacity = "0.9";
        sailed.style.strokeDasharray = String(ROUTE_LENGTH);

        const started = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - started) / REVEAL_ROUTE_MS);
          sailed.style.strokeDashoffset = String(ROUTE_LENGTH * (1 - easeOut(t)));
          if (t < 1) requestAnimationFrame(step);
          else handOver();
        };
        requestAnimationFrame(step);
      }

      /**
       * The bright stroke becomes the chart.
       *
       * It fades out exactly as the dashed line fades in, and underneath that
       * swap the sailed line is reset to nothing --- which is the truth of the
       * voyage at this moment. Odysseus is still at Troy on day zero, and the
       * shape that has just been drawn is where he is going, not where he has
       * been.
       */
      function handOver() {
        sailed.style.transition = `opacity ${REVEAL_HANDOVER_MS}ms ease`;
        unsailed.style.transition = `opacity ${REVEAL_HANDOVER_MS}ms ease`;
        sailed.style.opacity = "0";
        unsailed.style.opacity = "";

        window.setTimeout(() => {
          revealing = false;
          sailed.style.transition = "";
          unsailed.style.transition = "";
          sailed.style.opacity = "";
          drawShip(progress);
        }, REVEAL_HANDOVER_MS);
      }

      /** Straight to the voyage, with none of the ceremony. */
      function enterVoyage() {
        cancelAnimationFrame(crossingFrame);
        revealing = false;
        nostosProgress = 1;
        drawNostos(1);
        setStage("voyage");
        unlock();
        markerLayer.classList.remove("is-arriving");
        fitMap();
        current = -1;
        show(0);
      }

      /**
       * Back to the harbour.
       *
       * The prologue is the page's argument, not a gate to be got past once,
       * so it has to be reachable again --- by this control or by reloading.
       * Everything the reveal touched is put back: the two clocks, the dash
       * offsets it wrote inline, the stagger class, the camera, and the fact
       * that the whole basin has been seen, which is what decides whether the
       * next selection zooms.
       */
      function restartPrologue() {
        cancelAnimationFrame(frameRequest);
        cancelAnimationFrame(crossingFrame);
        revealing = false;

        progress = 0;
        day = 0;
        nostosProgress = 0;
        current = -1;
        hasSelected = false;

        // The reveal writes these inline and nothing else clears them.
        for (const line of [sailed, unsailed]) {
          line.style.opacity = "";
          line.style.transition = "";
        }
        markerLayer.classList.remove("is-arriving");

        setStage("prologue");
        lockToPrologue();
        setScale(0, false);

        el("nostos-day").textContent = "Day 0";
        el("nostos-note").textContent = "at Troy";
        el("day-count").textContent = "Day 0";
        el("day-note").textContent = "still at Troy";
        timeline.value = "0";

        showText(0);
        frameNostos();
        drawShip(0);
        drawNostos(0);
      }

      markers[0]!.addEventListener("click", () => {
        if (stage() === "prologue") sailNostos();
      });
      document.querySelector("#skip")!.addEventListener("click", enterVoyage);
      document
        .querySelector("#restart")!
        .addEventListener("click", restartPrologue);

      /**
       * The map can change size without the window doing anything.
       *
       * The rail taking its height back when the voyage arrives is exactly
       * that: a CSS height transition, which fires no resize event at all. A
       * hull placed against the old box would sit off its own course until
       * something else happened to redraw it. Before the voyage the camera is
       * re-framed outright, because a fit worked out for one window shape is
       * not the fit for another.
       */
      new ResizeObserver(() => {
        if (stage() === "voyage") applyView(0);
        else frameNostos();
      }).observe(frame);

      if (stage() === "prologue") {
        lockToPrologue();
        showText(0);
        frameNostos();
        drawNostos(0);
      } else {
        // Reduced motion, or a second look this session. The crossing is not
        // performed, but its result is on the map from the first frame: the
        // ship moored at Ithaca and the line it took drawn behind it.
        nostosProgress = 1;
        show(0);
        applyView(0);
        drawNostos(1);
      }

      /**
       * Both hulls and both courses are now placed, so they can be shown.
       *
       * Everything on those two layers is positioned by measurement the
       * browser has to take first: a ship by transform, a course by dash
       * offset. None of it is in the markup. Until this line runs the page
       * would paint a hull in the frame's top-left corner, off any coast, and
       * a course drawn end to end --- on the prologue that is the answer given
       * away before the visitor has sailed, and on the paths that skip it, the
       * whole twenty years shown as already sailed on day zero.
       *
       * It is only visible on a slow connection, which is exactly the visitor
       * least able to wait it out. The stylesheet holds both layers back until
       * this attribute lands.
       */
      root.dataset.ready = "true";
    </script>
  </body>
</html>
