---
import Placenames from "../components/placenames.astro";
import Seamarks from "../components/seamarks.astro";
import coastline from "../components/coastline.svg?raw";
import {
  BENCHMARKS,
  STOPS,
  STOPS_WITHOUT_DURATION,
  TOTAL_STATED_DAYS,
  dayAt,
  projectMarker,
  routePoints,
} from "../data/voyage.ts";
import "../styles/global.css";

const base = import.meta.env.BASE_URL;
const markers = STOPS.map((stop, i) => ({
  ...stop,
  index: i,
  marker: projectMarker(stop),
  day: dayAt(i),
}));

// A curve through the stops and the sea marks between them, not a polyline:
// a voyage drawn as straight hops reads as a network diagram, and several of
// those hops went over land. The curve passes exactly through each stop, so
// the line, the buttons and the ship still agree to the pixel.
const route = routePoints()
  .points.map((p) => `${p.x.toFixed(2)},${p.y.toFixed(2)}`)
  .join(" ");
const diomedes = BENCHMARKS.find((b) => b.id === "diomedes")!;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Diomedes sailed home from Troy in four days. Odysseus took twenty years. An interactive map of where the other sixteen went."
    />
    <title>Ten Years Late — Odysseus's detour</title>
  </head>
  <body>
    <header class="topbar">
      <nav aria-label="Primary">
        <a class="wordmark" href={base}>Ten Years Late</a>
      </nav>
      <div class="counters">
        <p class="counter is-ghost">
          <span class="counter-k">{diomedes.who}, {diomedes.source}</span>
          <span class="counter-v">Day {diomedes.day}</span>
          <span class="counter-n">home</span>
        </p>
        <p class="counter is-actual">
          <span class="counter-k">Odysseus</span>
          <span class="counter-v" id="day-count">Day 0</span>
          <span class="counter-n" id="day-note">still at Troy</span>
        </p>
      </div>
    </header>

    <main>
      <h1 class="visually-hidden">
        Ten Years Late — an interactive map of Odysseus's detour
      </h1>

      <div class="stage">
        <div class="map" id="map">
          {/* Markers are positioned as a percentage of this box, so the box has
              to hold the coastline's own aspect ratio exactly. Let the SVG
              letterbox inside a differently-shaped parent and every marker
              drifts off its coastline. */}
          <div class="map-frame">
            {/* Before the coastline, so the land draws over it. */}
            <Seamarks />
            <Fragment set:html={coastline} />
            {/* After the land, so the names sit on it as they do on a chart. */}
            <Placenames />
            <svg
              class="route"
              viewBox="0 0 100 100"
              preserveAspectRatio="none"
              aria-hidden="true"
              focusable="false"
            >
              {/* Two copies of the same line. The faint dashed one is the whole
                  voyage; the solid one is drawn in behind the ship by pulling
                  its dash offset back, so what has been sailed and what has
                  not are different marks rather than different colours. */}
              <polyline points={route} vector-effect="non-scaling-stroke" />
              <polyline
                id="route-sailed"
                points={route}
                vector-effect="non-scaling-stroke"
              />
            </svg>

            {/* The ship rides the route by transform, in pixels, so moving it
                never touches layout. Decorative: the panel and the counters
                carry the same information as text. */}
            <svg
              class="ship"
              id="ship"
              viewBox="0 0 40 26"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M2 15 L38 15 L33 22 L7 22 Z M19 15 L19 3 L20 3 L20 15 Z M20 4 L31 8 L20 12 Z"
              ></path>
            </svg>

            <div class="markers" role="group" aria-label="Voyage stops">
              {
                markers.map((m) => (
                  <button
                    class="marker"
                    type="button"
                    data-index={m.index}
                    aria-pressed="false"
                    aria-label={`Stop ${m.index + 1}, ${m.name}`}
                    style={`left:${m.marker.x}%;top:${m.marker.y}%`}
                  >
                    <span class="marker-dot">{m.index + 1}</span>
                    <span class="marker-name">{m.name}</span>
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        <aside class="panel" id="scene" aria-live="polite">
          <p class="panel-meta">
            <span class="panel-num" id="scene-num">1</span>
            <span class="panel-book" id="scene-book">Book 9</span>
          </p>
          <h2 class="panel-title" id="scene-title">Troy</h2>
          <p class="panel-epithet" id="scene-epithet">
            Twelve ships turn for home
          </p>
          <p class="panel-blurb" id="scene-blurb"></p>
          <p class="panel-days" id="scene-days"></p>
        </aside>
      </div>

      <div class="rail">
        <label class="visually-hidden" for="timeline">
          Voyage stop — drag or use the arrow keys
        </label>
        <input
          type="range"
          id="timeline"
          min="0"
          max={STOPS.length - 1}
          step="1"
          value="0"
          aria-describedby="rail-hint"
        />
        <div class="rail-ticks" aria-hidden="true">
          {
            markers.map((m) => (
              <span class="rail-tick" data-index={m.index}>
                <span class="rail-label">{m.name}</span>
              </span>
            ))
          }
        </div>
        <p class="rail-hint" id="rail-hint">
          {`Drag the timeline, or press a stop on the map. ${TOTAL_STATED_DAYS.toLocaleString()} days are all the poem actually counts — ${STOPS_WITHOUT_DURATION} of these fourteen stops carry no stated duration at all.`}
        </p>
      </div>
    </main>

    <script>
      import {
        BENCHMARKS,
        STOPS,
        dayAt,
        routePoints,
      } from "../data/voyage.ts";

      const timeline = document.querySelector<HTMLInputElement>("#timeline")!;
      const markers = [
        ...document.querySelectorAll<HTMLButtonElement>(".marker"),
      ];
      const ticks = [...document.querySelectorAll<HTMLElement>(".rail-tick")];
      const frame = document.querySelector<HTMLElement>(".map-frame")!;
      const ship = document.querySelector<SVGSVGElement>("#ship")!;
      const sailed = document.querySelector<SVGPolylineElement>("#route-sailed")!;
      const panel = document.querySelector<HTMLElement>("#scene")!;

      const el = (id: string) => document.getElementById(id)!;
      const diomedes = BENCHMARKS.find((b) => b.id === "diomedes")!;

      const stillness = window.matchMedia("(prefers-reduced-motion: reduce)");

      /**
       * The route in the same percentage space the markers use.
       *
       * Lengths along it have to be measured in *screen pixels*, not in the
       * svg's user units, and that is not a stylistic choice. The route carries
       * `vector-effect="non-scaling-stroke"`, which makes the browser generate
       * the stroke --- dash pattern included --- after the transform, in device
       * space. Feeding it user-unit lengths made the dash pattern repeat several
       * times along the route, so stretches the ship had not reached yet were
       * drawn as sailed. The svg is also `preserveAspectRatio="none"`, so there
       * is no single scale factor to convert by either: x and y have to be
       * scaled separately, which is what this does.
       */
      const { points: ROUTE, stopAt: STOP_AT } = routePoints();

      function metrics(box: DOMRect): { cum: number[]; total: number } {
        const cum = [0];
        for (let i = 1; i < ROUTE.length; i++) {
          const a = ROUTE[i - 1]!;
          const b = ROUTE[i]!;
          cum.push(
            cum[i - 1]! +
              Math.hypot(
                ((b.x - a.x) / 100) * box.width,
                ((b.y - a.y) / 100) * box.height,
              ),
          );
        }
        return { cum, total: cum[cum.length - 1]! };
      }

      /**
       * How far along the drawn line the ship is, for a fractional position in
       * the stop list.
       *
       * Interpolating by *length* rather than by sample index is what keeps the
       * ship at a steady speed: the curve is sampled evenly in its parameter,
       * not in distance, so a long leg and a short one carry the same number of
       * samples and stepping by index would sprint the long ones.
       */
      function lengthAt(progress: number, cum: number[]): number {
        const i = Math.max(0, Math.min(STOPS.length - 2, Math.floor(progress)));
        const t = Math.max(0, Math.min(1, progress - i));
        const from = cum[STOP_AT[i]!]!;
        const to = cum[STOP_AT[i + 1]!]!;
        return from + (to - from) * t;
      }

      /** The point at a given distance along the sampled curve. */
      function pointAtLength(length: number, cum: number[]): { x: number; y: number } {
        let lo = 0;
        let hi = cum.length - 1;
        while (lo < hi - 1) {
          const mid = (lo + hi) >> 1;
          if (cum[mid]! <= length) lo = mid;
          else hi = mid;
        }
        const span = cum[hi]! - cum[lo]!;
        const t = span === 0 ? 0 : (length - cum[lo]!) / span;
        const a = ROUTE[lo]!;
        const b = ROUTE[hi]!;
        return { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t };
      }

      function drawShip(progress: number) {
        const box = frame.getBoundingClientRect();
        if (box.width === 0) return;

        const { cum, total } = metrics(box);
        const travelled = lengthAt(progress, cum);
        const here = pointAtLength(travelled, cum);

        // Heading from a fixed distance along the line rather than a fixed
        // step in progress: near a tight bend the two are not the same, and a
        // progress step gives a bow that swings before the ship turns.
        const step = Math.max(2, total * 0.004);
        const ahead = pointAtLength(Math.min(total, travelled + step), cum);
        const behind = pointAtLength(Math.max(0, travelled - step), cum);

        // The frame is wider than it is tall and the route's user space is
        // stretched to match, so the heading has to be worked out in pixels.
        // Taking it from percentages points the bow at the wrong horizon.
        const angle =
          (Math.atan2(
            (ahead.y - behind.y) * box.height,
            (ahead.x - behind.x) * box.width,
          ) *
            180) /
          Math.PI;

        // A ship has an up. Rotating a west-bound heading past ninety degrees
        // turns the whole boat over and stands the mast on the sea floor, so
        // anything heading left is mirrored and rotated back instead --- the
        // bow still points along the course, and the mast still points at the
        // sky.
        const westbound = Math.abs(angle) > 90;
        const heading = westbound ? angle - 180 : angle;
        const mirror = westbound ? " scale(-1, 1)" : "";

        ship.style.transform = `translate(${(here.x / 100) * box.width}px, ${
          (here.y / 100) * box.height
        }px) translate(-50%, -50%) rotate(${heading}deg)${mirror}`;

        sailed.style.strokeDasharray = String(total);
        sailed.style.strokeDashoffset = String(total - travelled);
      }

      function describeLag(day: number): string {
        const behind = day - diomedes.day;
        if (behind <= 0) return "still on schedule";
        if (behind < 90) return `${behind} days behind Diomedes`;
        const plural = (n: number, unit: string) =>
          `${n} ${unit}${n === 1 ? "" : "s"}`;
        const years = Math.floor(behind / 365);
        const months = Math.round((behind % 365) / 30);
        if (years < 1) return `${plural(months, "month")} behind Diomedes`;
        const y = plural(years, "year");
        return months
          ? `${y} ${plural(months, "month")} behind Diomedes`
          : `${y} behind Diomedes`;
      }

      let current = -1;
      let progress = 0;
      let day = 0;
      let frameRequest = 0;

      /**
       * Sailing and staying are animated on two clocks, one after the other,
       * because that separation is the whole argument of the page.
       *
       * The ship crosses in about half a second wherever it is going --- the
       * distances are not the point. Then it sits still while the day counter
       * climbs the length of the stay, log-scaled so nine days is a blink and
       * Calypso's seven years is the longest thing on the page. The stop the
       * poem spends 85% of its counted time on is the one where nothing moves.
       */
      function travelTime(distance: number): number {
        if (stillness.matches) return 0;
        return 240 + 140 * Math.min(3, distance);
      }

      function dwellTime(days: number): number {
        if (stillness.matches || days <= 0) return 0;
        return Math.min(1500, 200 + 300 * Math.log10(1 + days));
      }

      const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

      function animateTo(index: number) {
        const fromProgress = progress;
        const fromDay = day;
        const toDay = dayAt(index);
        const travel = travelTime(Math.abs(index - fromProgress));
        const dwell = dwellTime(Math.abs(toDay - fromDay));
        const started = performance.now();

        cancelAnimationFrame(frameRequest);

        const step = (now: number) => {
          const t = now - started;
          const sailing = travel === 0 ? 1 : Math.min(1, t / travel);
          const staying =
            dwell === 0 ? 1 : Math.min(1, Math.max(0, (t - travel) / dwell));

          progress = fromProgress + (index - fromProgress) * easeOut(sailing);
          day = Math.round(fromDay + (toDay - fromDay) * easeOut(staying));

          drawShip(progress);
          el("day-count").textContent = `Day ${day.toLocaleString()}`;
          el("day-note").textContent =
            index === 0 && day === 0 ? "still at Troy" : describeLag(day);

          if (sailing < 1 || staying < 1) {
            frameRequest = requestAnimationFrame(step);
          }
        };

        frameRequest = requestAnimationFrame(step);
      }

      function show(index: number) {
        if (index === current) return;
        current = index;
        const stop = STOPS[index]!;

        // Restart the entrance animation rather than queueing one, so dragging
        // the timeline fast never leaves the panel mid-fade.
        panel.classList.remove("is-entering");
        void panel.offsetWidth;
        panel.classList.add("is-entering");

        el("scene-num").textContent = String(index + 1);
        el("scene-book").textContent = stop.book;
        el("scene-title").textContent = stop.name;
        el("scene-epithet").textContent = stop.epithet;
        el("scene-blurb").textContent = stop.blurb;

        el("scene-days").textContent =
          stop.days === null
            ? "The poem gives no duration for this stop."
            : stop.days === 0
              ? ""
              : `${stop.days.toLocaleString()} days — ${stop.daysNote}.`;
        el("scene-days").classList.toggle("is-gap", stop.days === null);

        animateTo(index);

        markers.forEach((m, i) => {
          m.setAttribute("aria-pressed", String(i === index));
          m.classList.toggle("is-active", i === index);
          m.classList.toggle("is-past", i < index);
        });
        ticks.forEach((t, i) => {
          t.classList.toggle("is-active", i === index);
          t.classList.toggle("is-past", i < index);
        });

        if (timeline.valueAsNumber !== index) timeline.value = String(index);

        // Announced from the arrival value, not the value the counter happens
        // to be rolling through: a screen reader should hear where the voyage
        // stands, not watch the animation.
        const arrival = dayAt(index);
        timeline.setAttribute(
          "aria-valuetext",
          `Stop ${index + 1} of ${STOPS.length}, ${stop.name}. Day ${arrival.toLocaleString()}. ${describeLag(arrival)}.`,
        );
      }

      // Percentages survive a resize; pixels do not, and the marker is redrawn
      // from the frame's current size each time.
      window.addEventListener("resize", () => drawShip(progress));

      timeline.addEventListener("input", () => show(timeline.valueAsNumber));
      markers.forEach((m, i) => m.addEventListener("click", () => show(i)));
      ticks.forEach((t, i) => t.addEventListener("click", () => show(i)));

      // The map itself answers to the keyboard, so a visitor who tabs to a
      // marker can walk the whole voyage without going back to the slider.
      document.querySelector("#map")!.addEventListener("keydown", (event) => {
        const e = event as KeyboardEvent;
        const moves: Record<string, number> = {
          ArrowRight: current + 1,
          ArrowDown: current + 1,
          ArrowLeft: current - 1,
          ArrowUp: current - 1,
          Home: 0,
          End: STOPS.length - 1,
        };
        const next = moves[e.key];
        if (next === undefined) return;
        e.preventDefault();
        const clamped = Math.max(0, Math.min(STOPS.length - 1, next));
        show(clamped);
        markers[clamped]!.focus();
      });

      show(0);
    </script>
  </body>
</html>
